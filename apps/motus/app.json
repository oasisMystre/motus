          "phantom",
          "cryptobrowser",
          "chainapp",
          "huddln",
          "verso",
          "haha",
          "modularwallet",
          "coinomi",
          "metamask",
          "trust",
          "safe",
          "rainbow",
          "uniswap",
          "zerion",
          "imtokenv2",
          "spot",
          "omni",
          "dfw",
          "tpoutside",
          "robinhood-wallet",
          "frontier",
          "blockchain-wallet",
          "safepalwallet",
          "bitkeep",
          "cbwallet",
          "oneinch",
          "exodus",
          "bnc",
          "ledgerlive",
          "mewwallet",
          "awallet",
          "keyring",
          "lobstr",
          "ontoprovider",
          "mathwallet",
          "unstoppabledomains",
          "obvious",
          "fireblocks-wc",
          "ambire",
          "internetmoney",
          "walletnow",
          "bitcoincom",
          "coin98",
          "arculuswc",
          "phantom",
          "cryptobrowser",
          "chainapp",
          "huddln",
          "verso",
          "haha",
          "modularwallet",
          "coinomi"
        ]
      },
      "appleTeamId": "P2V8V65U2Z"
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.motus",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./queries.js",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-firebase/crashlytics",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you upload avatars, customize equiments, exercise images and share them with your friends."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow $(PRODUCT_NAME) to access your device motion"
        }
      ],
      "expo-iap",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "motus",
          "organization": "gong-africa"
        }
      ],
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5cd0bb53-b9ae-4e1f-b93c-6ff13d0a6f8d"
      }
    },
    "owner": "apexflix",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/5cd0bb53-b9ae-4e1f-b93c-6ff13d0a6f8d"
    }
  }
}
