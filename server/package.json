{
  "name": "@motus/server",
  "type": "module",
  "private": true,
  "module": "./src/external.ts",
  "main": "./dist/external.cjs",
  "types": "./src/external.ts",
  "exports": {
    ".": {
      "types": "./src/external.ts",
      "import": "./src/external.ts",
      "require": "./dist/external.cjs",
      "default": "./dist/external.js"
    }
  },
  "scripts": {
    "check": "tsc --noEmit",
    "dev": "bun --watch run src/index.ts",
    "codegen": "bun run ./scripts/codegen.ts",
    "migrate": "drizzle-kit generate && drizzle-kit migrate",
    "mcp:dev": "bun x -y @modelcontextprotocol/inspector bun src/mcp.ts",
    "build": "tsup src/external.ts tsup src/index.ts --treeshake --minify --format esm,cjs --external bun"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.6",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.6",
    "pm2": "^6.0.13"
  },
  "peerDependencies": {
    "typescript": "^5.8.3",
    "ajv": "^8.12.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/session": "^11.1.0",
    "@modelcontextprotocol/sdk": "^1.20.1",
    "@motus/openfoodfacts": "*",
    "@openai/agents": "^0.1.10",
    "@openfoodfacts/openfoodfacts-nodejs": "^2.0.0-alpha.19",
    "@trpc/server": "^11.7.1",
    "@tsconfig/bun": "^1.0.9",
    "connect-redis": "^9.0.0",
    "cors": "^2.8.5",
    "devalue": "^5.4.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "fastify": "^5.6.1",
    "fastify-mcp": "^2.0.8",
    "firebase-admin": "^13.5.0",
    "fs": "^0.0.1-security",
    "ioredis": "^5.8.2",
    "moment": "^2.30.1",
    "openai": "^5.23.2",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.2",
    "superjson": "^2.2.5",
    "ws": "^8.18.3",
    "zod": "^4.1.12",
    "zod-to-json-schema": "^3.24.6"
  }
}
